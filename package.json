{
  "name": "fika-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fika Desk：在一个网页里同时使用服务器上的多个 AI Agent（Codex、Pi、Hermes、CodeBuddy 等），基于 ACP 协议",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts --dev",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "reset-password": "tsx server/index.ts reset-password"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "2.0.0",
    "@agentclientprotocol/sdk": "^1.5.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
